# macOS-inspired mako configuration

# Global settings
max-visible=5
sort=-time
layer=top
anchor=top-right

# Style settings (aligned with rofi tahoe.rasi palette/metrics)
font=SF Pro Display Medium 11
background-color=#1a1a1a99
text-color=#eeeeee
width=350
height=120
margin=20
padding=14
border-size=2
border-color=#232323ff
border-radius=12
progress-color=over #31e2ccff

# Icon settings
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=8

# Text settings
markup=1
format=<b>%s</b>\n%b
default-timeout=6000
group-by=app-name

# Urgency overrides
[urgency=low]
border-color=#232323ff

[urgency=normal]
border-color=#232323ff

[urgency=critical]
border-color=#ff3b30ff
default-timeout=0

# Instagram's web app sends a generic "You have unseen notifications." push
# alongside the real one (e.g. "Sent a reel", a DM) - hide the generic duplicate.
[body~="You have unseen notifications"]
invisible=1

# Vivaldi stages updates silently, then notifies "Vivaldi has been updated in
# the background. Please restart now to complete the update." - skip it.
[body~="updated in the background"]
invisible=1
