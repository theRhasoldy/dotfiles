# macOS-inspired mako configuration

# Global settings
max-visible=5
sort=-time
layer=top
anchor=top-right

# Style settings
font=sans-serif 10
background-color=#1e1e1ee6
text-color=#ffffff
width=350
height=120
margin=20
padding=15
border-size=1
border-color=#323232ff
border-radius=15
progress-color=over #007affff

# Icon settings
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=10

# Text settings
markup=1
format=<b>%s</b>\n%b
default-timeout=6000
group-by=app-name

# Urgency overrides
[urgency=low]
border-color=#323232ff

[urgency=normal]
border-color=#323232ff

[urgency=critical]
border-color=#ff3b30ff
default-timeout=0
