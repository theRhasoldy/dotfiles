[
  {
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 6,
    "modules-left": [
"idle_inhibitor",
      "hyprland/workspaces"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "hyprland/language",
      "tray",
      "network",
      "memory",
      "custom/opencode",
      "temperature",
      "battery",
      "backlight",
      "pulseaudio",
      "clock"
    ],
    "hyprland/language": {
      "format": "<b>{}</b>",
      "format-en": "US",
      "format-ar": "ARA"
    },
    "hyprland/workspaces": {
      "all-outputs": true,
      "active-only": false,
      "format": "{icon}",
      "format-icons": {
        "1": " ¹",
        "2": " ²",
        "3": "󰆦 ³",
        "4": " ⁴",
        "5": "󰬸 ⁵",
        "6": "󰧱 ⁶",
        "7": "󰚀 ⁷",
        "urgent": "",
        "focused": "",
        "default": ""
      }
    },
    // "custom/launcher": {
    //   "format": "",
    //   "on-click": "rofi --show drun",
    //   "tooltip": false
    // },
    "keyboard-state": {
      "numlock": true,
      "capslock": true,
      "format": "{name} {icon}",
      "format-icons": {
        "locked": "",
        "unlocked": ""
      }
    },
    "mpris": {
      "format": "{status_icon}  {artist} – <b>{title}</b>",
      // keep the bar compact: truncate the whole output to 30 chars
      // (full artist/title stay available in the tooltip)
      "max-length": 30,
      "status-icons": {
        "paused": "",
        "playing": ""
      },
      "format-stopped": "Stopped",
      "tooltip-format": "{player} ({status})\n{artist} – {title}",
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl previous",
      "on-click-right": "playerctl next",
      "on-scroll-up": "playerctl volume 0.02+",
      "on-scroll-down": "playerctl volume 0.02-"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": ""
      }
    },
    "tray": {
      "spacing": 10
    },
    "clock": {
      "format": "󱑁  {:%H:%M}",
      // "timezone": "America/New_York",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "󰃮  {:%Y-%m-%d}"
    },
    "memory": {
      "format": "󰎓  {used}GB | {total}GB"
    },
    "custom/opencode": {
      "exec": "$HOME/.config/scripts/opencode-usage.sh",
      "interval": 300,
      "return-type": "json",
      "tooltip": true,
      "on-click": "bash -c 'notify-send -a opencode \"opencode usage\" \"$($HOME/.config/scripts/opencode-usage.sh 0 | jq -r .tooltip)\"'"
    },
    "temperature": {
      "thermal-zone": 2,
      "hwmon-path": "/sys/class/thermal/thermal_zone2/temp",
      "critical-threshold": 80,
      "format-critical": "{icon}  {temperatureC} 󰔄",
      "format": "{icon} {temperatureC} 󰔄",
      "format-icons": ["󱃃 ", "󰸁 ", "󰔐 "]
    },
    "backlight": {
      // "device": "acpi_video1",
      "format": "{icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
      "states": {
        "good": 80,
        "warning": 30,
        "critical": 15
      },
      "format": "{icon}  {capacity}",
      "format-charging": "󰚥  {capacity}",
      "format-plugged": "󰚥  {capacity}",
      "format-alt": "{icon}  {time}",
      "format-icons": ["󰂎", "󰁼", "󰁿", "󰂂", "󰁹"]
    },
    "network": {
      "on-click": "bash ~/.config/scripts/wifi-picker.sh",
      "on-click-right": "nm-connection-editor",
      "format-wifi": "󰤨  {signalStrength}",
      "format-ethernet": "{ipaddr}/{cidr} ",
      "tooltip-format-wifi": "󰤨  {essid}  ({signalStrength}%)",
      "tooltip-format-ethernet": "{ifname} via {gwaddr} ",
      "tooltip-format-disconnected": "Disconnected",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "󰤮  Disconnected",
      "format-disabled": "󰤭  Off",
      "tooltip-format-disabled": "Wi-Fi disabled"
    },
    "pulseaudio": {
      "scroll-step": 5, // %, can be a float
      "format": "{format_source}  {icon}  {volume}",
      "format-bluetooth": "{format_source}  {icon}  {volume}",
      "format-bluetooth-muted": "{icon}  {volume}",
      "format-muted": " {format_source}",
      "format-source": " ",
      "format-source-muted": " ",
      "format-icons": {
        "headphone": " ",
        "hands-free": " ",
        "headset": " ",
        "phone": " ",
        "portable": " ",
        "car": " ",
        "default": ["", "", "󰕾"]
      },
      "on-click": "pavucontrol"
    }
  }
]
