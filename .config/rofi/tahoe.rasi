/* Tahoe — macOS-style launcher theme for rofi 2.0.
 *
 * Imported from ~/.config/rofi/config.rasi via @theme (rofi 2.0 only applies
 * theme elements that follow an @theme line; inline styles in the config
 * file are no longer read). Colors are the user's original palette;
 * hyprglass ("tahoe" preset: blur + edge rim) renders behind the panel.
 *
 * Var names bg0/bg1/bg2/fg0/fg1/fg2 are kept: the other rofi modes
 * (powermenu, clipboard, ...) reference them. */

* {
    font: "SF Pro Display, Avenir 11";

    bg0: rgba(26, 26, 26, 60%);
    bg1: rgba(26, 26, 26, 60%);
    bg2: rgba(49, 226, 204, 35%);

    fg0: #eeeeee;
    fg1: #eeeeee;
    fg2: #e4e0f980;

    background-color: transparent;
    text-color: @fg0;

    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: @bg0;
    location: center;
    width: 620;
    border: 2px;
    border-color: #232323;
    border-radius: 12;
}

inputbar {
    font: "SF Pro Display, Avenir Medium 15";
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg1;
    font: "Symbols Nerd Font 16";
    padding: 0 2px 0 0;
}

entry {
    text-color: @fg0;
    placeholder: "Search";
    placeholder-color: @fg2;
    padding: 4px 0;
}

message {
    background-color: @bg1;
    border-color: @bg1;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    border: 0;
    padding: 4px 0 0 0;
    spacing: 2px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    background-color: transparent;
    text-color: @fg0;
    border-radius: 8;
}

element normal active {
    text-color: @bg2;
}

element selected normal, element selected active {
    background-color: @bg2;
    text-color: #eeeeee;
}

element-icon {
    size: 1.8em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    padding: 10px 0;
}

num-rows {
    enabled: false;
}
