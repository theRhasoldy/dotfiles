configuration {
	display-drun: "";
	display-window: "";
	drun-display-format: "{icons} {name}";
	font: "SF Pro Display 10";
	modi: "drun,run,window";
	show-icons: true;
	kb-remove-to-eol: "";
	kb-accept-entry: "Return";

  timeout {
    action: "kb-cancel";
    delay:  5;
  }

	drun {
		display-name: "";
	}

	run {
		display-name: "󰧚";
	}

	window {
		display-name: "";
	}

	// emoji {
	// 	display-name: "󰱲";
	// }
}

/* Style blocks were moved to tahoe.rasi. rofi 2.0 only applies theme
 * elements that are imported via @theme after the configuration block. */
@theme "/home/rhasoldy/.config/rofi/tahoe.rasi"
